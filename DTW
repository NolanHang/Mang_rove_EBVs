def load_csv(path):
    df = pd.read_csv(path, index_col=0)
    if df.shape[1] < METADATA_COLUMNS + 2:
        raise ValueError("CSV requires date columns followed by two metadata columns")
    values = df.iloc[:, :-METADATA_COLUMNS].copy()
    dates = pd.DatetimeIndex(pd.to_datetime(values.columns, errors="raise"))
    if dates.hasnans or dates.has_duplicates:
        raise ValueError("Date columns must be valid and unique")
    if len(dates) < 2:
        raise ValueError("At least two observation dates are needed")
    order = np.argsort(dates.to_numpy())
    dates = dates[order]
    values = values.iloc[:, order]
    values = values.apply(pd.to_numeric, errors="coerce")
    values = values.replace([np.inf, -np.inf], np.nan)
    x = values.to_numpy(dtype=float)
    x_clean = x.copy()
    total_outliers = 0
    for i in range(len(x)):
        valid = np.isfinite(x[i])
        if valid.sum() < 4:
            continue
        q1, q3 = np.quantile(x[i, valid], [0.25, 0.75])
        iqr = q3 - q1
        mask = valid & ((x[i] < q1 - IQR_OUTLIER_THRESHOLD * iqr) |
                        (x[i] > q3 + IQR_OUTLIER_THRESHOLD * iqr))
        total_outliers += int(mask.sum())
        x_clean[i, mask] = np.nan
    print(f"  Outliers marked missing (not interpolated): {total_outliers}")
    return x_clean, df.index.astype(str).tolist(), dates


def standardize_rows(x):
    z = np.full_like(x, np.nan, dtype=float)
    eligible = np.zeros(len(x), dtype=bool)
    reasons = []
    for i, row in enumerate(x):
        valid = np.isfinite(row)
        if valid.sum() < MIN_DTW_OBSERVATIONS:
            reasons.append("too_few_observations")
            continue
        std = float(np.std(row[valid]))
        if not np.isfinite(std) or std <= 1e-10:
            reasons.append("no_shape_constant_series")
            continue
        z[i, valid] = (row[valid] - float(np.mean(row[valid]))) / std
        eligible[i] = True
        reasons.append("")
    return z, eligible, reasons


def dtw_distance(z1, z2, dates):
    if fastdtw is None:
        raise ImportError("Install FastDTW first: pip install fastdtw")
    m1, m2 = np.isfinite(z1), np.isfinite(z2)
    if DTW_DATE_PENALTY == 0:
        a, b = z1[m1], z2[m2]
        cost, path = fastdtw(a, b, radius=DTW_RADIUS)
    else:
        t = np.asarray((dates - dates[0]).days, dtype=float) / 365.25
        a = np.column_stack([z1[m1], t[m1]])
        b = np.column_stack([z2[m2], t[m2]])
        cost, path = fastdtw(a, b, radius=DTW_RADIUS, dist=_point_cost)
    return float(cost / len(path))


def _point_cost(u, v):
    return abs(u[0] - v[0]) + DTW_DATE_PENALTY * abs(u[1] - v[1])

