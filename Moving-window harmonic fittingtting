def smooth_curve(x, y, window=15, polyorder=3):
    if len(x) < 5:
        return interp1d(x, y, kind='linear', fill_value='extrapolate')
    df_tmp = pd.DataFrame({'x': x, 'y': y}).drop_duplicates('x').sort_values('x')
    x_uq = df_tmp['x'].values
    y_uq = df_tmp['y'].values
    n = len(x_uq)
    w = min(window, n)
    if w % 2 == 0:
        w -= 1
    if w < 5:
        return interp1d(x_uq, y_uq, kind='cubic', fill_value='extrapolate')
    y_smooth = savgol_filter(y_uq, window_length=w, polyorder=polyorder)
    return interp1d(x_uq, y_smooth, kind='cubic', fill_value='extrapolate')

def harmonic_trend_model(t, a, b, *coeffs):
    trend = a + b * t
    omega = 2.0 * np.pi / T_FIXED
    seasonal = np.zeros_like(t, dtype=float)
    n_harm = len(coeffs) // 2
    for k in range(n_harm):
        C = coeffs[2*k]
        D = coeffs[2*k+1]
        seasonal += C * np.cos((k+1) * omega * t) + D * np.sin((k+1) * omega * t)
    return trend + seasonal

def fit_window(x_obs, y_obs):
    a0 = np.mean(y_obs)
    b0 = 0.0
    amp_est = np.std(y_obs) * 1.5
    n_coeffs = 2 * HARMONIC_ORDER
    p0 = [a0, b0] + [0.0] * n_coeffs
    bounds_lower = [-np.inf, -0.001] + [-amp_est] * n_coeffs
    bounds_upper = [np.inf, 0.001] + [amp_est] * n_coeffs
    try:
        popt, _ = curve_fit(lambda t, *p: harmonic_trend_model(t, *p),
                            x_obs, y_obs, p0=p0,
                            bounds=(bounds_lower, bounds_upper), maxfev=20000)
        return popt
    except:
        return None


def compute_circular_quantiles(series, quantiles=[0.5, 0.25, 0.75]):
    if len(series) == 0:
        return [np.nan] * len(quantiles)
    doy = np.array(series.dropna())
    if len(doy) == 0:
        return [np.nan] * len(quantiles)

    best_t = 0
    best_iqr = np.inf
    for t in range(365):
        adj = (doy + t) % 365
        iqr = np.percentile(adj, 75) - np.percentile(adj, 25)
        if iqr < best_iqr:
            best_iqr = iqr
            best_t = t

    adj_best = (doy + best_t) % 365
    results = []
    for q in quantiles:
        q_val = np.percentile(adj_best, q * 100)
        doy_result = (q_val - best_t) % 365  
        results.append(doy_result)
    return results

