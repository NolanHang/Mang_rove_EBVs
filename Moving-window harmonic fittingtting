def _parse_dates_compatible(raw: pd.Series) -> pd.Series:
    text = raw.astype("string").str.strip()
    text = text.replace({"": pd.NA, "nan": pd.NA, "NaT": pd.NA, "None": pd.NA})
    eight = text.str.fullmatch(r"(?:19|20)\d{6}", na=False).fillna(False)
    parsed = pd.Series(pd.NaT, index=raw.index, dtype="datetime64[ns]")
    if eight.any():
        parsed.loc[eight] = pd.to_datetime(text.loc[eight], format="%Y%m%d", errors="coerce")
    other = ~eight
    if other.any():
        version = str(pd.__version__).split(".")[0]
        supports_mixed = version.isdigit() and int(version) >= 2
        if supports_mixed:
            part = pd.to_datetime(text.loc[other], errors="coerce", format="mixed")
            if part.notna().sum() == 0 and text.loc[other].notna().any():
                part = pd.to_datetime(text.loc[other], errors="coerce")
        else:
            part = pd.to_datetime(text.loc[other], errors="coerce")
        parsed.loc[other] = part
    return parsed


def read_observations(path: Path) -> pd.DataFrame:
    path = Path(path)
    try:
        df = pd.read_csv(path, encoding="utf-8-sig")
    except UnicodeDecodeError:
        df = pd.read_csv(path, encoding="gb18030")
    df.columns = [str(name).strip().lower() for name in df.columns]
    if not {"t", "y"}.issubset(df.columns):
        columns = ", ".join(repr(c) for c in df.columns[:12])
        raise ValueError(
            f"{path.name} is missing required t/y columns. Found columns: [{columns}]. "
            "Make sure file_local points to a raw time-series CSV (t=date, y=index value), "
            "not a previously generated statistics CSV."
        )
    if df.empty:
        raise ValueError(f"{path.name} is empty and contains no observations.")

    dates = _parse_dates_compatible(df["t"])
    vals = pd.to_numeric(df["y"], errors="coerce")
    if dates.notna().sum() == 0:
        samples = df["t"].head(4).tolist()
        raise ValueError(
            f"All dates in column t of {path.name} failed to parse. Examples: {samples}; "
            f"pandas version: {pd.__version__}."
        )
    if vals.notna().sum() == 0:
        samples = df["y"].head(4).tolist()
        raise ValueError(f"All numeric values in column y of {path.name} are invalid. Examples: {samples}")
    obs = pd.DataFrame({"t": dates, "y": vals}).dropna()
    obs = obs[np.isfinite(obs["y"])]
    if obs.empty:
        raise ValueError(
            f"{path.name} has no rows with both a valid date and a valid numeric value."
        )
    obs["t"] = obs["t"].dt.normalize()
    obs = obs.groupby("t", as_index=False)["y"].mean().sort_values("t").reset_index(drop=True)
    if len(obs) < 2:
        raise ValueError(
            f"{path.name} has only {len(obs)} distinct valid observation dates; at least two are required."
        )
    obs["year"] = obs["t"].dt.year
    obs["x_days"] = (obs["t"] - obs["t"].min()).dt.days.astype(float)
    return obs


def _design_matrix(x: np.ndarray, center: float) -> np.ndarray:
    x = np.asarray(x, float)
    columns = [np.ones_like(x), (x-center)/T_FIXED]
    for k in range(1, HARMONIC_ORDER+1):
        angle = 2*np.pi*k*x/T_FIXED
        columns.extend([np.cos(angle), np.sin(angle)])
    return np.column_stack(columns)


def _fit_window(x: np.ndarray, y: np.ndarray, center: float):
    if len(x) < MIN_OBS_PER_WINDOW or not np.isfinite(y).all():
        return None
    loc = float(np.mean(y))
    scale = float(np.std(y))
    if scale < max(1e-12, 1e-11*abs(loc)):
        return None
    a = _design_matrix(x, center)
    yn = (y-loc)/scale
    lo = [-np.inf, -3.0] + [-1.5]*(2*HARMONIC_ORDER)
    hi = [np.inf, 3.0] + [1.5]*(2*HARMONIC_ORDER)
    try:
        result = lsq_linear(a, yn, bounds=(lo,hi), max_iter=250)
    except (ValueError, np.linalg.LinAlgError):
        return None
    if not result.success or not np.isfinite(result.x).all():
        return None
    return center, loc, scale, result.x


