def safe_name(text):
    return re.sub(r'[<>:"/\\|?*]+', "_", str(text)).strip(" .")


def read_csv_auto(path, nrows=None):
    for encoding in ("utf-8-sig", "gb18030"):
        try:
            return pd.read_csv(path, encoding=encoding, nrows=nrows)
        except UnicodeDecodeError:
            continue
    raise ValueError(f"Unable to determine CSV encoding: {path}")


def discover_tasks():
    if not AUTO_DISCOVER:
        return [(str(BASE_DIR / name), species, x, y)
                for name, species, x, y in MANUAL_TASKS]
    paths = (BASE_DIR.rglob("*.csv") if RECURSIVE_SEARCH
             else BASE_DIR.glob("*.csv"))
    result = []
    for path in sorted(paths):
        if OUTPUT_DIR in path.parents:
            continue
        try:
            columns = set(read_csv_auto(path, nrows=0).columns)
        except Exception as exc:
            print(f"[Skipped file] {path.name}: {exc}", flush=True)
            continue
        label = path.stem.split("-", 1)[0]
        species = SPECIES_MAP.get(label, label)
        for x, y in VARIABLE_PAIRS:
            if {"date", x, y}.issubset(columns) and x != y:
                result.append((str(path), species, x, y))
    return result


def interpolate_short_gaps(series, max_gap):
    s = series.astype(float).copy()
    if not s.isna().any():
        return s
    interpolated = s.interpolate(method="time", limit_area="inside")
    missing = s.isna()
    group_id = missing.ne(missing.shift(fill_value=False)).cumsum()
    lengths = missing.groupby(group_id).transform("sum")
    s.loc[missing & (lengths <= max_gap)] = interpolated.loc[
        missing & (lengths <= max_gap)]
    return s
