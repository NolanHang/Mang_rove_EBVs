var MODIS_col = ee.ImageCollection('MODIS/061/MOD09A1');

var Index = require('users/NO1/Image_deal:compute_Index');
var ReCloud = require('users/NO1/Image_deal:Remove_cloud/remove_cloud_collection');

var aoi = beilun_River;
var points_export = BG;
var point_col_name = 'BG_Pints';

var index_List = ['NDVI','GDVI','LAI','NDMIw'];

var windowSize_time = 60;
var windowSize_space = 3;

var exportFolder = 'HLS_MODIS_time_series';
var exportScale = 30;

for (var num = 0; num < index_List.length; num++) {

  var index = index_List[num];

  print('========================');
  print('Processing:', index);

  var TS1 = buildFusionPeriod('2015-01-01', '2017-01-01', index);

  var TS2 = buildFusionPeriod('2017-01-01', '2019-01-01', index);

  var TS3 = buildHLSPeriod('2019-01-01', '2026-01-01', index);

  var all_TS = TS1.merge(TS2).merge(TS3).sort('system:time_start');

  print(index + '_image_count', all_TS.size());

  var number_name = all_TS.aggregate_array('system:time_start').map(function(t) {
    return ee.Date(t).format('YYYY-MM-dd');
  });

  var dataset = all_TS.select(index).toBands().rename(number_name);

  print(index + '_dataset', dataset);

  var points_list = points_export.toList(points_export.size());
  var sequence = ee.List.sequence(0, points_list.size().subtract(1));

  var points_time_series = ee.FeatureCollection(
    ee.List(sequence.iterate(time_export, ee.List([])))
  );

  print(index + '_samples', points_time_series.limit(5));

  Export.table.toDrive({
    collection: points_time_series,
    description: point_col_name + '_HLS_MODIS_' + index,
    folder: exportFolder,
    fileNamePrefix: point_col_name + '_' + index + '_2015_2025',
    fileFormat: 'CSV'
  });
}

function time_export(i, first) {

  i = ee.Number(i);

  var feature = ee.Feature(points_list.get(i));
  var geo = feature.geometry();

  var values = dataset.reduceRegion({
    reducer: ee.Reducer.first(),
    geometry: geo,
    scale: exportScale,
    bestEffort: true
  });

  var coord = geo.coordinates();

  var output = ee.Feature(null, values)
    .copyProperties(feature)
    .set('point_id', i)
    .set('longitude', coord.get(0))
    .set('latitude', coord.get(1));

  return ee.List(first).add(output);
}

function buildFusionPeriod(startDate, endDate, indexName) {

  var bandList = ['time', indexName];

  var HLS = TS_daily_only(
    re_HLSTS(ee.Date(startDate).advance(-windowSize_time, 'day'), endDate, aoi)
  );

  var HLSIndexSuper = Compute_index(HLS, indexName)
    .map(maskHighQualityVegetation)
    .select(indexName)
    .map(time_band)
    .select(bandList);

  var HLSIndex = HLSIndexSuper.filterDate(startDate, endDate).select(indexName);

  var MODIS = MODIS_col.filterDate(startDate, endDate)
    .filterBounds(aoi)
    .map(ReCloud.MODISA1_remove_cloud)
    .map(ReCloud.Scale_image_MODIS_SR)
    .select(
      ['sur_refl_b03','sur_refl_b04','sur_refl_b01','sur_refl_b02','sur_refl_b06','sur_refl_b07'],
      ['B1','B2','B3','B4','B5','B7']
    );

  var MODISIndex = Compute_index(MODIS, indexName)
    .map(MODIS_resample)
    .map(maskHighQualityVegetation)
    .select(indexName)
    .map(time_band)
    .select(bandList);

  var modisDates = only_date_list(MODISIndex).slice(1, -1);

  var fused = ee.ImageCollection.fromImages(
    modisDates.map(function(targetDate) {
      return STARFM(
        ee.Date(targetDate),
        HLSIndexSuper,
        MODISIndex,
        windowSize_time,
        windowSize_space,
        bandList,
        indexName
      );
    })
  );

  return TS_daily_only(
    HLSIndex.merge(fused).sort('system:time_start')
  );
}
